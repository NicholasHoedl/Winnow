# Winnow environment variables — copy to .env and fill in.
# .env is gitignored; never commit real secrets.
#
# One file serves both local development and the production deploy, so a few keys below
# are used by only one of them. Each says which.

# --- App config ---
# IANA timezone used for "due today" / "overdue" calculations.
APP_TIME_ZONE="America/Chicago"

# Currency for money display (amounts are stored as integer minor units regardless).
APP_CURRENCY="USD"

# --- Open Food Facts (the app's only outbound HTTP — see docs/adr/0005-*.md) ---
# Set to "false" on an install with no internet: the food-database search and the
# barcode scanner disappear instead of offering a lookup that can never succeed.
# The app container needs outbound HTTPS for this to work.
OFF_ENABLED="true"
# Two hosts because OFF splits them: products-by-barcode and full-text search.
# Override to point at a local mirror.
OFF_API_URL="https://world.openfoodfacts.org"
OFF_SEARCH_URL="https://search.openfoodfacts.org"

# --- AI companion (see docs/adr/0011-*.md) ---
# Opt-IN, unlike OFF above: this one costs money per call and sends data to a third
# party, so a fresh install has it off and /companion does not exist.
#
# HARD BOUNDARY, per ADR-0011: journal and note content is NEVER sent to this provider,
# by any feature. Journal-aware features are deferred until a local model can run them.
AI_ENABLED="false"
# Any OpenAI-compatible /chat/completions endpoint, without a trailing slash.
AI_BASE_URL=""
AI_MODEL=""
AI_API_KEY=""

# --- Database ---
#
# DATABASE_URL means two DIFFERENT things depending on who reads it, and getting this
# wrong is the first thing that goes wrong on a deploy:
#
#   * The app CONTAINER never reads this line. docker-compose.prod.yml builds its own
#     URL from POSTGRES_PASSWORD below, pointing at the compose hostname `postgres`.
#   * Your SHELL reads it, for `pnpm db:migrate` and `pnpm db:seed`. Those run on the
#     host, because drizzle-kit is a dev dependency and is not in the runtime image.
#     From the host the database is only reachable if its port is published — and in
#     production it deliberately is NOT. See docs/runbooks/deploy.md, which publishes
#     it temporarily for the one-time migrate + seed and then takes it away again.
#
# Local development (docker/docker-compose.yml publishes 5432):
DATABASE_URL="postgresql://winnow:winnow@localhost:5432/winnow"

# Production ONLY: docker-compose.prod.yml refuses to start without this. It is the
# password for the `winnow` database role, and it is not the same thing as the one
# baked into the dev URL above.
POSTGRES_PASSWORD=""

# --- Auth.js (added in Checkpoint 0.2) ---
# Generate a secret with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=""

# --- Single-user seed (used by the seed script, NOT a public signup) ---
SEED_USER_EMAIL="you@example.com"
SEED_USER_PASSWORD=""
SEED_USER_NAME="Your Name"
